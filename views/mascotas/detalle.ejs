<article class="detalle">
    <!--<p class="etiqueta"><%= mascota.especie %></p>-->
    <h1><%= mascota.nombre %></h1>
    <h2>Especie: <%= mascota.especie %></h2>
    <img src="/img/mascota.png" text alt="imagen de la mascota seleccionada" style="display: block; margin: 0 auto; width: 8rem; height: 8rem;">
    <dl>
        <dt>Estado</dt>
        <dd><%= mascota.estado %></dd>
        <dt>Edad</dt>
        <dd><%= mascota.edad %></dd>
    </dl>
    <p><%= mascota.descripcion %></p>
    <a href="/mascotas">Volver al Listado</a>
</article>

    