<header class="cabecera-pagina">
    <div>
        <p class="etiqueta">LISTADO DE MASCOTAS</p>
        <h1><%= titulo %></h1>
    </div>

    <a class="boton" href="/mascotas/nueva">Agregar mascota</a>
</header>
<!-- Si el arrary de plantas tiene una longitud de 0 muestra el mensaje no hay plantas-->
 <% if(mascotas.length === 0) {%> 
    <p>No hay mascotas para mostrar</p>
 <% } else { %>
    <section class="grilla" aria-label="Listado de mascotas">
        <!--Vamos a iterar en cada objeto plantas y extrae sus datos-->
        <% mascotas.forEach((mascota) =>{%>
            <article class="soft-card">
                <!--<p class="card-body"><%= mascota.tipo %></p>-->
                <h2 class="card-header"><%= mascota.nombre %></h2>
                <p>Especie: <%= mascota.especie %></p>
                <p>Edad: <%= mascota.edad %></p>
                <p>Estado: <%= mascota.estado %></p>
                <br>
                <a class="card-btn" href="/mascotas/<%= mascota.id %>">Mas datos</a>
                
            </article>
             
       <% }) %>
    </section>
 <% } %>